# M5 Path-1.5: real icudtl.dat embed.
# Replaces the empty kIcuData placeholder previously aliased through
# :bazel_link_stubs. Mirrors runtime/bin/BUILD.gn:781 (bin_to_linkable
# "icudtl_linkable") + runtime/tools/bin_to_assembly.py.
genrule(
    name = "dart_icudata_S",
    srcs = ["//third_party/icu/flutter:icudtl.dat"],
    outs = ["dart_icudata.S"],
    tools = ["//runtime/tools:bin_to_assembly.py"],
    cmd = "python3 $(location //runtime/tools:bin_to_assembly.py) " +
          "--input $(location //third_party/icu/flutter:icudtl.dat) " +
          "--output $@ " +
          "--symbol_name kIcuData " +
          "--target_os linux " +
          "--target_arch x64",
)

cc_library(
    name = "icudtl_linkable",
    srcs = [":dart_icudata_S"],
)

# M5 Path-1.5: real kernel_service.dill embed.
# Replaces the empty kKernelServiceDill placeholder previously aliased
# through :bazel_link_stubs. Mirrors runtime/bin/BUILD.gn:765
# (bin_to_linkable "kernel_service_dill_linkable") but uses .incbin
# directly instead of bin_to_assembly.py — 17MB byte-by-byte would
# explode the .S file. The dill is co-located in $(RULEDIR) so the
# assembler can resolve the .incbin path.
genrule(
    name = "dart_kernel_service_dill_S",
    srcs = ["//out/ReleaseX64/gen:kernel_service.dill"],
    outs = [
        "dart_kernel_service_dill.S",
        "dart_kernel_service.dill",
    ],
    cmd = "cp $(execpath //out/ReleaseX64/gen:kernel_service.dill) $(RULEDIR)/dart_kernel_service.dill && " +
          "SIZE=$$(stat -c %s $(RULEDIR)/dart_kernel_service.dill) && " +
          "{ echo '.section .rodata'; " +
          "  echo '.type kKernelServiceDill STT_OBJECT'; " +
          "  echo '.global kKernelServiceDill'; " +
          "  echo '.balign 32'; " +
          "  echo 'kKernelServiceDill:'; " +
          "  echo \".incbin \\\"$(RULEDIR)/dart_kernel_service.dill\\\"\"; " +
          "  echo '.size kKernelServiceDill, .-kKernelServiceDill'; " +
          "  echo '.global kKernelServiceDillSize'; " +
          "  echo 'kKernelServiceDillSize:'; " +
          "  echo \".quad $$SIZE\"; " +
          "} > $(RULEDIR)/dart_kernel_service_dill.S",
)

filegroup(
    name = "dart_kernel_service_dill_S_only",
    srcs = ["dart_kernel_service_dill.S"],
)

filegroup(
    name = "dart_kernel_service_dill_only",
    srcs = ["dart_kernel_service.dill"],
)

cc_library(
    name = "kernel_service_dill_linkable",
    srcs = [":dart_kernel_service_dill_S_only"],
    additional_compiler_inputs = [":dart_kernel_service_dill_only"],
)

