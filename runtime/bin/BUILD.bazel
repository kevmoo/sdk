# Real kDartCoreSnapshotData + kDartCoreSnapshotText (M5 Path-1.5 closeout).
# Replaces the empty placeholders previously aliased through :bazel_link_stubs.
# Mirrors runtime/bin/BUILD.gn:core_snapshot_data_linkable /
# core_snapshot_text_linkable.
#
# Sources are pre-built core snapshot bytes in out/ReleaseX64/gen/runtime/bin/
# (regenerable via `bazel-bin/runtime/bin/gen_snapshot --snapshot_kind=core
# --snapshot_data=out/ReleaseX64/gen/runtime/bin/core_snapshot_data.bin
# --snapshot_text=out/ReleaseX64/gen/runtime/bin/core_snapshot_text.bin
# out/ReleaseX64/vm_platform_stripped.dill`). We don't drive gen_snapshot
# from a Bazel genrule because that would force gen_snapshot's full
# dependency graph to build in exec configuration, which exposes a number
# of strict-C++ failures in third_party/zlib (.c files treated as C++ by
# clang++ as driver). Mirrors the kPlatformDill / kKernelServiceDill
# pattern (also pre-built blobs from out/).
genrule(
    name = "dart_core_snapshot_data_S",
    srcs = ["//out/ReleaseX64/gen/runtime/bin:core_snapshot_data.bin"],
    outs = [
        "core_snapshot_data.S",
        "dart_core_snapshot_data.bin",
    ],
    cmd = "cp $(execpath //out/ReleaseX64/gen/runtime/bin:core_snapshot_data.bin) $(RULEDIR)/dart_core_snapshot_data.bin && " +
          "{ echo '.section .rodata'; " +
          "  echo '.type kDartCoreSnapshotData STT_OBJECT'; " +
          "  echo '.global kDartCoreSnapshotData'; " +
          "  echo '.balign 32'; " +
          "  echo 'kDartCoreSnapshotData:'; " +
          "  echo \".incbin \\\"$(RULEDIR)/dart_core_snapshot_data.bin\\\"\"; " +
          "  echo '.size kDartCoreSnapshotData, .-kDartCoreSnapshotData'; " +
          "} > $(RULEDIR)/core_snapshot_data.S",
)

# JIT core snapshots have an empty text section; we still emit a defined
# (zero-size) symbol so the link resolves and the VM's nullptr/data-driven
# checks see a valid pointer.
genrule(
    name = "dart_core_snapshot_text_S",
    srcs = ["//out/ReleaseX64/gen/runtime/bin:core_snapshot_text.bin"],
    outs = [
        "core_snapshot_text.S",
        "dart_core_snapshot_text.bin",
    ],
    cmd = "cp $(execpath //out/ReleaseX64/gen/runtime/bin:core_snapshot_text.bin) $(RULEDIR)/dart_core_snapshot_text.bin && " +
          "{ echo '.section .rodata'; " +
          "  echo '.type kDartCoreSnapshotText STT_OBJECT'; " +
          "  echo '.global kDartCoreSnapshotText'; " +
          "  echo '.balign 32'; " +
          "  echo 'kDartCoreSnapshotText:'; " +
          "  echo \".incbin \\\"$(RULEDIR)/dart_core_snapshot_text.bin\\\"\"; " +
          "  echo '.size kDartCoreSnapshotText, .-kDartCoreSnapshotText'; " +
          "} > $(RULEDIR)/core_snapshot_text.S",
)

filegroup(
    name = "dart_core_snapshot_data_S_only",
    srcs = ["core_snapshot_data.S"],
)

filegroup(
    name = "dart_core_snapshot_data_bin_only",
    srcs = ["dart_core_snapshot_data.bin"],
)

filegroup(
