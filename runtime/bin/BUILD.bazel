# M5 Path-1.5: real vm_platform.dill embed.
# Replaces the empty kPlatformDill placeholder previously aliased through
# :bazel_link_stubs. Mirrors runtime/bin/BUILD.gn:773 (bin_to_linkable
# "platform_dill_linkable"). Uses .incbin (see :dart_kernel_service_dill_S
# above for the same pattern + rationale).
genrule(
    name = "dart_platform_dill_S",
    srcs = ["//runtime/vm:vm_platform.dill"],
    outs = [
        "dart_platform_dill.S",
        "dart_vm_platform.dill",
    ],
    cmd = "cp $(execpath //runtime/vm:vm_platform.dill) $(RULEDIR)/dart_vm_platform.dill && " +
          "SIZE=$$(stat -c %s $(RULEDIR)/dart_vm_platform.dill) && " +
          "{ echo '.section .rodata'; " +
          "  echo '.type kPlatformDill STT_OBJECT'; " +
          "  echo '.global kPlatformDill'; " +
          "  echo '.balign 32'; " +
          "  echo 'kPlatformDill:'; " +
          "  echo \".incbin \\\"$(RULEDIR)/dart_vm_platform.dill\\\"\"; " +
          "  echo '.size kPlatformDill, .-kPlatformDill'; " +
          "  echo '.global kPlatformDillSize'; " +
          "  echo 'kPlatformDillSize:'; " +
          "  echo \".quad $$SIZE\"; " +
