load("@rules_cc//cc:defs.bzl", "cc_library")

# Shim target directing package consumers to Bzlmod external repository,
# while exporting the checked-in proto headers to satisfy sandboxed inclusions.

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "libprotozero",
    hdrs = glob(["protos/**/*.pbzero.h"]),
    deps = ["@perfetto//:libprotozero"],
)
