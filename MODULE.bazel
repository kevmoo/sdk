module(
    name = "dart_sdk",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Provides bool_flag (//build/config:dart_debug) for the M4 debug<->release
# select() axis. Already in the resolved graph transitively (selected 1.8.2);
# declared here to make @bazel_skylib//rules:common_settings.bzl loadable.
bazel_dep(name = "bazel_skylib", version = "1.8.2")

dart_clang = use_extension("//build/toolchain/linux:clang_repo.bzl", "dart_clang")
use_repo(dart_clang, "dart_linux_x64_clang")

register_toolchains(
    "//build/toolchain/linux:clang_x64_toolchain",
    "//build/toolchain/linux:clang_arm64_toolchain",
    "//tools/bazel/dart:prebuilt_dart_toolchain",
)

dart_tests = use_extension("//tools/bazel/dart:test_rules.bzl", "dart_tests_extension")
use_repo(
    dart_tests,
    "dart_tests",
    "dart_tests_cfe",
    "dart_tests_vm_debug",
    "dart_tests_vm_product",
    "dart_tests_wasm_asserts_d8",
    "dart_tests_wasm_d8",
    "dart_tests_wasm_optimized_d8",
)

third_party = use_extension("//tools/bazel:third_party.bzl", "third_party_extension")
use_repo(third_party, "icu", "zlib")
