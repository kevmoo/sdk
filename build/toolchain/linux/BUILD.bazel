load("@rules_cc//cc:defs.bzl", "cc_library", "cc_toolchain")
load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# Files the cc_toolchain claims as inputs to every C++ action so Bazel
# sandboxes the clang install correctly. See buildtools/linux-x64/clang/
# BUILD.bazel for the placeholder note about this package.
filegroup(
    name = "clang_files",
    srcs = ["@dart_linux_x64_clang//:all_files"],
)

filegroup(name = "empty")

cc_toolchain_config(name = "clang_x64_config")

cc_toolchain(
    name = "clang_x64",
    all_files = ":clang_files",
    ar_files = ":clang_files",
    as_files = ":clang_files",
    compiler_files = ":clang_files",
    dwp_files = ":empty",
    linker_files = ":clang_files",
    objcopy_files = ":clang_files",
    strip_files = ":clang_files",
    toolchain_config = ":clang_x64_config",
    toolchain_identifier = "clang_x64",
)

toolchain(
    name = "clang_x64_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":clang_x64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Smoke-test target: confirms the toolchain can actually compile something.
# Built via `bazelisk build //build/toolchain/linux:smoke_test`.
cc_library(
    name = "smoke_test",
    srcs = ["smoke_test.cc"],
)
